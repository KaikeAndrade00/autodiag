# Configurações do Banco de Dados Cloud SQL (PostgreSQL)
DB_HOST=10.x.x.x
DB_PORT=5432
DB_NAME=autodiag_db
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_segura

# Portas de Rede dos Microsserviços
GATEWAY_PORT=8000
CATALOG_SERVICE_PORT=50051
DIAGNOSTIC_SERVICE_PORT=50052
BILLING_SERVICE_PORT=50053

# Configurações de Segurança e JWT
JWT_SECRET_KEY=sua_chave_secreta_jwt_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
